# BhopCraft configuration template. Copy to .env and edit; Vite only exposes keys prefixed with VITE_ to the game.
# Every key is optional: missing or invalid values fall back to the defaults shown here (see src/config.ts),
# and the fallback is logged as a warning.

# Movement preset: css_bhop (bhop-server style: 100 tick, sv_airaccelerate 1000, auto-bhop)
# or css_vanilla (stock CS:S: 66.67 tick, sv_airaccelerate 10, 110% speed cap, timed jumps).
VITE_PRESET=css_bhop

# World generation seed (integer). Same seed -> same terrain.
VITE_SEED=1337

# View radius in chunks (16x16 blocks each), 2..16.
VITE_RENDER_DISTANCE=6

# Horizontal field of view in degrees at a 4:3 aspect, like CS:S default_fov (wider screens see more, "Hor+").
VITE_FOV=90

# Mouse sensitivity, same scale as CS:S: degrees turned = mouse counts * 0.022 * sensitivity.
VITE_SENSITIVITY=2

# Minimum log level: debug | info | warn | error.
VITE_LOG_LEVEL=info

# Optional movement cvar overrides on top of the preset (names as in CS:S, upper-cased, VITE_ prefix).
# Booleans accept 1/0/true/false. Leave commented to use the preset's value. Ranges: src/physics/cvars.ts CVAR_SCHEMA.
# VITE_TICK_INTERVAL=0.01
# VITE_SV_AIRACCELERATE=1000
# VITE_SV_ACCELERATE=5
# VITE_SV_FRICTION=4
# VITE_SV_STOPSPEED=75
# VITE_SV_GRAVITY=800
# VITE_SV_MAXSPEED=250
# VITE_SV_MAXVELOCITY=3500
# VITE_SV_ENABLEBUNNYHOPPING=1
# VITE_SV_AUTOBUNNYHOPPING=1
