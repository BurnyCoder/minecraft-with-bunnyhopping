{
  "name": "minecraft-with-bunnyhopping",
  "version": "0.1.0",
  "description": "BhopCraft: a browser Minecraft-style voxel game whose player movement is a port of Counter-Strike: Source movement (bunnyhopping + air strafing).",
  "type": "module",
  "private": true,
  "author": "Libor Burian",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "experiments": "tsx experiments/run-all.ts"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
